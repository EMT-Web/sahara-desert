+<section class="page-header">
+  <div class="hero-slider" role="img" aria-label="The palm oasis and earthen village of Tinghir below the Todra Valley in southern Morocco">
+    <div class="hero-slide" style="background-image:url('images/todra-valley.jpg'); animation:none; opacity:1;"></div>
